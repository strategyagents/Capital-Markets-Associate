GOOGLE_API_KEY=
DEFAULT_GOOGLE_MODEL=gemini-2.0-flash-exp
MODEL_PROVIDER=gemini  # gemini | litellm

# LiteLLM compatibility when switching to local Ollama/MLX models
LITELLM_BASE_URL=
LITELLM_MODEL=ollama/gpt-oss:120b
LITELLM_API_KEY=

# Observability / Graylog via OTLP gRPC
# GRAYLOG_OTLP_GRPC_ENDPOINT=10.20.80.15:4317
GRAYLOG_OTLP_GRPC_ENDPOINT=otel-collector:4317
GRAYLOG_GELF_ENDPOINT=
GRAYLOG_OTLP_EXPORTER_ENDPOINT=
GRAYLOG_INSECURE=true
GRAYLOG_SERVICE_NAMESPACE=Capital-Markets-Agent
GRAYLOG_TRACE_SAMPLE_RATIO=1.0
GRAYLOG_ZIPKIN_ENDPOINT=

# MCP server access
MCP_SERVER_URL=
MCP_API_KEY=
MCP_REQUEST_TIMEOUT=30

# Agent-specific MCP tool allowlists
ORCHESTRATOR_MCP_TOOL_ALLOWLIST=
PORTFOLIO_MCP_TOOL_ALLOWLIST=
ANALYTICS_MCP_TOOL_ALLOWLIST=
TRADER_MCP_TOOL_ALLOWLIST=

# MCP Endpoints Overrides
# MCP_TOOL_ENDPOINT_read_orders=GET:/order/open?paper=false
# MCP_TOOL_ENDPOINT_get_open_orders_order_open_get=GET:/order/open?paper=false
# MCP_TOOL_ENDPOINT_execute_trade=POST:/easy_order/entry?paper={paper}&sym={sym}&entry={entry}
# MCP_TOOL_ENDPOINT_get_quoteSnapshot_marketdata_quote_snapshot_get=GET:/marketdata/quote-snapshot?symbols={symbols}&paper=false

# Telegram human-in-the-loop configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_APPROVER_USERNAME=
HUMAN_APPROVAL_REQUIRED=true
APPROVAL_WAIT_TIMEOUT_SECONDS=600

# Session + runtime configuration
SESSION_DB_ROOT=data/sessions
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8080
DEFAULT_AGENT_APP_NAME=apital-Markets-Agent
HUMAN_APPROVAL_REQUIRED=true

# Trade Station endpoint simulator account flag
TRADER_PAPER=true

# External endpoints for orchestrator to reach peers during ADK web dev
PORTFOLIO_URL=http://localhost:8080/agent-proxy/portfolio
ANALYTICS_URL=http://localhost:8080/agent-proxy/analytics
TRADER_URL=http://localhost:8080/agent-proxy/trader
ORCHESTRATOR_URL=http://localhost:8080/agent-proxy/orchestrator

# Optional webhooks
TRADER_WEBHOOK_URL=
PORTFOLIO_DATA_SOURCE=

